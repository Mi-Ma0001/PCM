{
  "name": "Plan de maintenance CMS",
  "short_name": "Maintenance CMS",
  "description": "Plan de maintenance préventive : échéances, planning, charge des techniciens, conflits et Gantt.",
  "id": "/",
  "start_url": "./#tableau",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "fr",
  "dir": "ltr",
  "background_color": "#0f3d2e",
